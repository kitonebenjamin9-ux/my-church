rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function role(){ return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : ''; }
  function admin(){ return role() in ['admin','Admin','pastor','Pastor']; }
  function manager(){ return role() in ['admin','Admin','pastor','Pastor','editor','Editor']; }
  match /users/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || admin());
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'member';
   allow update: if admin() || (request.auth.uid == uid && request.resource.data.role == resource.data.role);
   allow delete: if admin();
  }
  match /{collection}/{id} {
   allow read: if collection in ['siteSettings','branches','ministries','ministryLeaders','events','sermons','announcements','dailyVerses','gallery','mediaLibrary','heroVideos','churchProject','mediaLibrary'];
   allow write: if manager() && collection in ['siteSettings','branches','ministries','ministryLeaders','events','sermons','announcements','dailyVerses','gallery','mediaLibrary','heroVideos','churchProject','mediaLibrary'];
  }
  match /notifications/{id} { allow read: if true; allow write: if manager(); }
  match /videoTestimonies/{id} { allow read: if resource.data.status == 'approved' || admin(); allow create: if request.resource.data.status == 'pending'; allow update,delete: if admin(); }
  match /contactMessages/{id} { allow create: if request.resource.data.status == 'new'; allow read,update,delete: if admin(); }
  match /registrations/{id} { allow create: if true; allow read,update,delete: if admin(); }
  match /eventRegistrations/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin()); allow update,delete: if admin(); }
  match /prayerRequests/{id} { allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow read: if signedIn() && (resource.data.uid == request.auth.uid || admin()); allow update,delete: if admin(); }
 }
}
